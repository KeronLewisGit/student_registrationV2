

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ---------------------------------------------------------------------------
# Security: block web access to version control, internal storage, vendor
# code, archives, and credential files. These must never be downloadable.
# ---------------------------------------------------------------------------
RedirectMatch 404 (?i)^/\.git
RedirectMatch 404 (?i)^/storage(/|$)
RedirectMatch 404 (?i)^/vendor(/|$)
RedirectMatch 404 (?i)^/slss-laravel(/|$)

<FilesMatch "^(connect\.php|db_credentials\.php|auth_bootstrap\.php|composer\.json|composer\.lock)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(gz|tar|zip|sql|log|env|lock|bak)$">
  Require all denied
</FilesMatch>
